# ---------------------------------------------------------------------------
# Chaves de IA. Nunca comitar valores reais: este arquivo e so um modelo.
# Em producao, cadastrar em Vercel > Project > Settings > Environment Variables.
# ---------------------------------------------------------------------------

# OpenRouter (Jev orquestrador). https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Modelo do Jev para o papel de orquestrador (gera JSON de decisao).
OPENROUTER_JEV_MODEL=typesafe/jev-router

# Google Gemini (visao + redacao). https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Desliga as rotas de IA e usa somente o motor deterministico.
# Qualquer valor diferente de "true" mantem a IA habilitada.
IA_DESABILITADA=false
